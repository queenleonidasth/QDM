{
    "name":  "QDM - QUEEN Download Manager",
    "version":  "0.4.2",
    "description":  "Native download manager integration with opt-in capture, browser session forwarding and safe fallback",
    "permissions":  [
                        "contextMenus",
                        "storage",
                        "downloads",
                        "nativeMessaging",
                        "cookies"
                    ],
    "icons":  {
                  "48":  "icon.png",
                  "128":  "icon.png"
              },
    "options_ui":  {
                       "page":  "options.html",
                       "open_in_tab":  true
                   },
    "manifest_version":  3,
    "host_permissions":  [
                             "http://127.0.0.1/*",
                             "<all_urls>"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "Download with QDM"
               }
}
