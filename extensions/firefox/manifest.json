{
  "name": "QDM — QUEEN Download Manager",
  "version": "0.3.1",
  "description": "ดักดาวน์โหลดไฟล์ HTTP(S) จาก Zen อัตโนมัติ แล้วส่งเข้า QDM (หรือใช้ Zen ต่อเมื่อ QDM ไม่พร้อม)",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "http://127.0.0.1/*"
  ],
  "icons": { "48": "icon.png", "128": "icon.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "manifest_version": 2,
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "QDM — Auto Download"
  },
  "browser_specific_settings": {
    "gecko": { "id": "qdm@queen.local", "strict_min_version": "128.0" }
  }
}

